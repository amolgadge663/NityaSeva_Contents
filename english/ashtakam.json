  "items": [
    {
      "id": "ashtakam_shiva",
      "title": "Shiva Ashtakam",
      "language": "english",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/aarti/shiv.jpg",
      "orderIndex": 1,
      "content": [
        {
          "shloka": "Prabhum Prananatham Vibhum Vishwanatham",
          "transliteration": "Prabhuṁ prāṇanāthaṁ vibhuṁ viśvanāthaṁ",
          "meaning": "Salutations to Shiva, the lord of life and master of the universe."
        },
        {
          "shloka": "Jagannatham Natham Sadananda Bhajam",
          "transliteration": "Jagannāthaṁ nāthaṁ sadānanda bhajaṁ",
          "meaning": "I worship Shiva, the eternal source of bliss."
        }
      ]
    },
    {
      "id": "ashtakam_dattatreya",
      "title": "Dattatreya Ashtakam",
      "language": "english",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/ashtakam/shree_gurudev_datta.jpg",
      "orderIndex": 2,
      "content": [
        {
          "shloka": "Jai Dev Jai Dev Digambara",
          "meaning": "Dattatreya represents the combined form of the Trimurti."
        }
      ]
    },
    {
      "id": "ashtakam_krishna",
      "title": "Krishna Ashtakam",
      "language": "english",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/ashtakam/krishna.jpg",
      "orderIndex": 3,
      "content": [
        {
          "shloka": "Vasudeva Suta Deva",
          "meaning": "Krishna is the supreme Lord and guide for humanity."
        }
      ]
    },
    {
      "id": "ashtakam_linga",
      "title": "Lingashtakam",
      "language": "english",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/ashtakam/namah_shivaya.jpg",
      "orderIndex": 4,
      "content": [
        {
          "shloka": "Brahma Murari Surarchita Lingam",
          "meaning": "The Shiva Linga represents the cosmic form of Shiva."
        }
      ]
    }
  ]
}
