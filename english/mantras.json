    {
      "id": "mantra_gayatri",
      "title": "Gayatri Mantra",
      "language": "english",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/mantras/matra_devi.jpg",
      "orderIndex": 1,
      "content": [
        {
          "shloka": "Sarve Bhavantu Sukhinah",
          "transliteration": "Sarve bhavantu sukhinaḥ",
          "meaning": "May all beings be happy."
        },
        {
          "shloka": "Sarve Santu Niramayah",
          "transliteration": "Sarve santu nirāmayāḥ",
          "meaning": "May all be free from illness."
        }
      ]
    },
    {
      "id": "mantra_mahamrityunjay",
      "title": "Maha Mrityunjaya Mantra",
      "language": "english",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/aarti/shiv.jpg",
      "orderIndex": 2,
      "content": [
        {
          "shloka": "Om Tryambakam Yajamahe",
          "meaning": "A mantra of protection and freedom from fear."
        }
      ]
    },
    {
      "id": "mantra_ram",
      "title": "Shri Ram Mantra",
      "language": "english",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/mantras/ram.jpg",
      "orderIndex": 3,
      "content": [
        {
          "shloka": "Shri Ram Jai Ram Jai Jai Ram",
          "meaning": "Chanting Ram’s name brings peace and devotion."
        }
      ]
    },
    {
      "id": "mantra_durga",
      "title": "Durga Mantra",
      "language": "english",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/chalisa/durga.jpg",
      "orderIndex": 4,
      "content": [
        {
          "shloka": "Om Dum Durgayai Namah",
          "meaning": "A mantra invoking strength, courage, and protection."
        }
      ]
    }
  ]
