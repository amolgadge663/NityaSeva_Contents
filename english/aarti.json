  "category": "Aarti",
  "version": 1,
  "items": [
    {
      "id": "aarti_ganapati",
      "title": "Ganapati Aarti",
      "language": "english",
      "image": "ganpati.png",
      "orderIndex": 1,
      "content": [
        {
          "shloka": "Sukhkarta Dukhharta Varta Vighnachi",
          "transliteration": "Sukhkartā dukhhartā vārtā vighnāchī",
          "meaning": "You are the giver of happiness and remover of sorrow, the one who eliminates obstacles."
        },
        {
          "shloka": "Jai Dev Jai Dev Jai Mangalmurti",
          "transliteration": "Jai Dev Jai Dev Jai Mangalmūrtī",
          "meaning": "Victory to you, O auspicious idol, bestower of blessings."
        }
      ]
    },
    {
      "id": "aarti_durga",
      "title": "Durga Aarti",
      "language": "english",
      "image": "durga.png",
      "orderIndex": 2,
      "content": [
        {
          "shloka": "Jai Devi Jai Devi Mahishasuramardini",
          "transliteration": "Jai Devī Jai Devī Mahīṣāsuramardinī",
          "meaning": "Victory to Goddess Durga, slayer of the demon Mahishasura."
        },
        {
          "shloka": "Sur Nar Muni Jan Sevat",
          "transliteration": "Sur nar muni jan sevat",
          "meaning": "She is worshipped by gods, humans, and sages alike."
        }
      ]
    },
    {
      "id": "aarti_vitthal",
      "title": "Vitthal Aarti",
      "language": "english",
      "image": "vitthal.png",
      "orderIndex": 3,
      "content": [
        {
          "shloka": "Pandurang, the divine form",
          "meaning": "Vitthal guides devotees towards devotion and truth."
        }
      ]
    },
    {
      "id": "aarti_shankar",
      "title": "Shankar Aarti",
      "language": "english",
      "image": "shankar.png",
      "orderIndex": 4,
      "content": [
        {
          "shloka": "With Kartikeya and Ganesha",
          "meaning": "Shankar (Shiva) is the supreme protector of the universe."
        }
      ]
    }
  ]
}
