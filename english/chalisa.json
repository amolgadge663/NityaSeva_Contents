      "id": "chalisa_hanuman",
      "title": "Hanuman Chalisa",
      "language": "english",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/chalisa/hanuman.jpg",
      "orderIndex": 1,
      "content": [
        {
          "shloka": "Shri Guru Charan Saroj Raj",
          "transliteration": "Śrī guru charan saroja raja",
          "meaning": "With the dust of my Guru’s lotus feet, I cleanse the mirror of my mind."
        },
        {
          "shloka": "Budhi Heen Tanu Janike",
          "transliteration": "Buddhi hīn tanu jānike",
          "meaning": "Knowing my intellect to be weak, I remember Hanuman to grant me strength."
        }
      ]
    },
    {
      "id": "chalisa_durga",
      "title": "Durga Chalisa",
      "language": "english",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/chalisa/durga.jpg",
      "orderIndex": 2,
      "content": [
        {
          "shloka": "Namo Namo Durge Sukh Karni",
          "meaning": "Durga brings prosperity and removes obstacles."
        }
      ]
    },
    {
      "id": "chalisa_shani",
      "title": "Shani Chalisa",
      "language": "english",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/chalisa/shani.jpg",
      "orderIndex": 3,
      "content": [
        {
          "shloka": "Jai Jai Shri Shanidev Bhagwan",
          "meaning": "Shani Dev gives justice based on karma."
        }
      ]
    },
    {
      "id": "chalisa_laxmi",
      "title": "Laxmi Chalisa",
      "language": "english",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/chalisa/lakshmi_2.jpg",
      "orderIndex": 4,
      "content": [
        {
          "shloka": "Jai Laxmi Mata",
          "meaning": "Goddess Laxmi grants wealth, prosperity, and blessings."
        }
      ]
    }
  ]
