{
  "category": "Ashtakam",
  "version": 1,
  "items": [
    {
      "id": "ashtakam_shiva",
      "title": "शिवाष्टकम",
      "language": "hindi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/aarti/shiv.jpg",
      "orderIndex": 1,
      "content": [
        {
          "shloka": "प्रभुं प्राणनाथं विभुं विश्वनाथं",
          "meaning": "भगवान शिव प्राणों के स्वामी और सम्पूर्ण विश्व के नाथ हैं।",
          "transliteration": null,
          "imageUrl": null
        },
        {
          "shloka": "भजे शिवं शंकरं",
          "meaning": "मैं शिव शंकर का भजन करता हूँ।",
          "transliteration": null,
          "imageUrl": null
        }
      ]
    },
    {
      "id": "ashtakam_dattatreya",
      "title": "दत्ताष्टकम",
      "language": "hindi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/ashtakam/shree_gurudev_datta.jpg",
      "orderIndex": 2,
      "content": [
        {
          "shloka": "जय देव जय देव दिगंबरा",
          "meaning": "दत्तात्रेय ब्रह्मा, विष्णु और शिव के संयुक्त अवतार हैं।"
        }
      ]
    },
    {
      "id": "ashtakam_krishna",
      "title": "कृष्णाष्टकम",
      "language": "hindi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/ashtakam/krishna.jpg",
      "orderIndex": 3,
      "content": [
        {
          "shloka": "वासुदेवसुतं देवं",
          "meaning": "भगवान कृष्ण परम दयालु और धर्मस्थापक हैं।"
        }
      ]
    },
    {
      "id": "ashtakam_linga",
      "title": "लिंगाष्टकम",
      "language": "hindi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/ashtakam/namah_shivaya.jpg",
      "orderIndex": 4,
      "content": [
        {
          "shloka": "ब्रह्ममुरारी सुरार्चित लिंगम्",
          "meaning": "शिवलिंग शिव के अनंत स्वरूप का प्रतीक है।"
        }
      ]
    }
  ]
}
