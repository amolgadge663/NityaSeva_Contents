    {
      "id": "katha_sai",
      "title": "साई कथा",
      "language": "hindi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/katha/sai.jpg",
      "orderIndex": 1,
      "content": [
        {
          "shloka": "साई कृपा सब पर रहती है",
          "meaning": "साईं बाबा सभी भक्तों पर दया करते हैं।"
        }
      ]
    },
    {
      "id": "katha_ganapati",
      "title": "गणेश कथा",
      "language": "hindi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/aarti/ganesh.jpg",
      "orderIndex": 2,
      "content": [
        {
          "shloka": "माता पार्वती ने गणेश जी की रचना अपने शरीर से की।",
          "meaning": "यह कथा मातृत्व और भक्ति का प्रतीक है।",
          "transliteration": null,
          "imageUrl": null
        },
        {
          "shloka": "भगवान शिव ने गणेश को प्रथम पूज्य बनाया।",
          "meaning": "इस कारण गणेश को विघ्नहर्ता कहा जाता है।",
          "transliteration": null,
          "imageUrl": null
        }
      ]
    },
    {
      "id": "katha_datta",
      "title": "दत्त कथा",
      "language": "hindi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/ashtakam/shree_gurudev_datta.jpg",
      "orderIndex": 3,
      "content": [
        {
          "shloka": "दत्त अवतार कथा",
          "meaning": "दत्तात्रेय त्रिमूर्ति का दिव्य अवतार हैं।"
        }
      ]
    },
    {
      "id": "katha_vitthal",
      "title": "विठ्ठल कथा",
      "language": "hindi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/aarti/Panduranga.jpg",
      "orderIndex": 4,
      "content": [
        {
          "shloka": "विठ्ठल पंडरपुर कथा",
          "meaning": "विठ्ठल भगवान भक्तों के प्रेम से प्रकट हुए।"
        }
      ]
    }
  ]
}
