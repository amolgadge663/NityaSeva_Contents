  "items": [
    {
      "id": "chalisa_hanuman",
      "title": "हनुमान चालीसा",
      "language": "hindi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/chalisa/hanuman.jpg",
      "orderIndex": 1,
      "content": [
        {
          "shloka": "जय शिव ओंकारा हर शिव ओंकारा",
          "meaning": "हे शिव भगवान, आप सृष्टि के आधार हैं।",
          "transliteration": null,
          "imageUrl": null
        },
        {
          "shloka": "ब्रह्मा विष्णु सदाशिव अर्द्धांगी धारा",
          "meaning": "आप ब्रह्मा, विष्णु और महेश तीनों के स्वरूप हैं।",
          "transliteration": null,
          "imageUrl": null
        }
      ]
    },
    {
      "id": "chalisa_durga",
      "title": "दुर्गा चालीसा",
      "language": "hindi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/chalisa/durga.jpg",
      "orderIndex": 2,
      "content": [
        {
          "shloka": "नमो नमो दुर्गे सुख करनी",
          "meaning": "माता दुर्गा अपने भक्तों का कल्याण करती हैं।"
        }
      ]
    },
    {
      "id": "chalisa_shani",
      "title": "शनि चालीसा",
      "language": "hindi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/chalisa/shani.jpg",
      "orderIndex": 3,
      "content": [
        {
          "shloka": "जय जय श्री शनिदेव भगवान",
          "meaning": "शनि देव कर्म के आधार पर फल देने वाले देवता हैं।"
        }
      ]
    },
    {
      "id": "chalisa_laxmi",
      "title": "लक्ष्मी चालीसा",
      "language": "hindi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/chalisa/lakshmi_2.jpg",
      "orderIndex": 4,
      "content": [
        {
          "shloka": "जय लक्ष्मी माता",
          "meaning": "लक्ष्मी माँ सौभाग्य, धन और समृद्धि प्रदान करती हैं।"
        }
      ]
    }
  ]
}
