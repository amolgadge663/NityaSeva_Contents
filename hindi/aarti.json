{
  "category": "Aarti",
  "version": 1,
  "items": [
    {
      "id": "aarti_ganapati",
      "title": "गणपति आरती",
      "language": "hindi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/aarti/ganesh.jpg",
      "orderIndex": 1,
      "content": [
        {
          "shloka": "जय देव जय देव जय श्री गणेशा",
          "meaning": "हे गणेश भगवान, आपकी जय हो। आप सभी विघ्नों को दूर करने वाले हैं।",
          "transliteration": null,
          "imageUrl": null
        },
        {
          "shloka": "मंगल मूर्ति मोरया",
          "meaning": "हे मंगलमूर्ति, कृपा करके शीघ्र पधारिए।",
          "transliteration": null,
          "imageUrl": null
        }
      ]
    },
    {
      "id": "aarti_durga",
      "title": "दुर्गा आरती",
      "language": "hindi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/aarti/durga_devi.jpg",
      "orderIndex": 2,
      "content": [
        {
          "shloka": "जय अम्बे गौरी, मैया जय श्यामा गौरी",
          "meaning": "माता दुर्गा सभी भक्तों की रक्षा करती हैं।"
        }
      ]
    },
    {
      "id": "aarti_vitthal",
      "title": "विठ्ठल आरती",
      "language": "hindi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/aarti/Panduranga.jpg",
      "orderIndex": 3,
      "content": [
        {
          "shloka": "युगों-युगों के नाथ विठ्ठल",
          "meaning": "विठ्ठल भक्तों के दुःख दूर करने वाले भगवान हैं।"
        }
      ]
    },
    {
      "id": "aarti_shankar",
      "title": "शंकर आरती",
      "language": "hindi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/aarti/shiv.jpg",
      "orderIndex": 4,
      "content": [
        {
          "shloka": "जय शिव ओंकारा हर शिव ओंकारा",
          "meaning": "हे शिव भगवान, आप सृष्टि के आधार हैं।",
          "transliteration": null,
          "imageUrl": null
        },
        {
          "shloka": "ब्रह्मा विष्णु सदाशिव अर्द्धांगी धारा",
          "meaning": "आप ब्रह्मा, विष्णु और महेश तीनों के स्वरूप हैं।",
          "transliteration": null,
          "imageUrl": null
        }
      ]
    }
  ]
}
