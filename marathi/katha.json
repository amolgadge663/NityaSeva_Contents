    {
      "id": "katha_sai",
      "title": "साई कथा",
      "language": "marathi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/katha/sai.jpg",
      "orderIndex": 1,
      "content": [
        {
          "shloka": "साई कृपा सर्वांवर",
          "meaning": "साई बाबा सर्व जीवांवर दया करतात."
        }
      ]
    },
    {
      "id": "katha_ganapati",
      "title": "गणेश कथा",
      "language": "marathi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/aarti/ganesh.jpg",
      "orderIndex": 2,
      "content": [
        {
          "shloka": "पार्वती देवीने आपल्या अंगच्या मळापासून गणपतीची निर्मिती केली.",
          "meaning": "ही कथा मातृप्रेम व भक्तीचे प्रतीक आहे.",
          "transliteration": null,
          "imageUrl": null
        },
        {
          "shloka": "भगवान शंकरांनी गणपतीला प्रथम पूजेचा मान दिला.",
          "meaning": "यामुळे गणपतीला विघ्नहर्ता मानले जाते.",
          "transliteration": null,
          "imageUrl": null
        }
      ]
    },
    {
      "id": "katha_datta",
      "title": "दत्त कथा",
      "language": "marathi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/ashtakam/shree_gurudev_datta.jpg",
      "orderIndex": 3,
      "content": [
        {
          "shloka": "दत्त अवतार कथा",
          "meaning": "दत्तात्रेय हा त्रिमूर्तीचा अवतार आहे."
        }
      ]
    },
    {
      "id": "katha_vitthal",
      "title": "विठ्ठल कथा",
      "language": "marathi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/aarti/Panduranga.jpg",
      "orderIndex": 4,
      "content": [
        {
          "shloka": "विठ्ठल पंढरी कथा",
          "meaning": "विठ्ठल भक्तांसाठी प्रकट झाला."
        }
      ]
    }
  ]
}
