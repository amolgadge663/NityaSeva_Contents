{
  "category": "Mantras",
  "version": 1,
  "items": [
    {
      "id": "mantra_gayatri",
      "title": "गायत्री मंत्र",
      "language": "marathi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/mantras/matra_devi.jpg",
      "orderIndex": 1,
      "content": [
        {
          "shloka": "सर्वे भवन्तु सुखिनः",
          "meaning": "सर्व लोक सुखी असोत.",
          "transliteration": null,
          "imageUrl": null
        },
        {
          "shloka": "सर्वे सन्तु निरामयाः",
          "meaning": "सर्व लोक निरोगी असोत.",
          "transliteration": null,
          "imageUrl": null
        }
      ]
    },
    {
      "id": "mantra_mahamrityunjay",
      "title": "महामृत्युंजय मंत्र",
      "language": "marathi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/aarti/shiv.jpg",
      "orderIndex": 2,
      "content": [
        {
          "shloka": "ॐ त्र्यम्बकं यजामहे",
          "meaning": "मृत्यूवर विजय देणारा शिव मंत्र."
        }
      ]
    },
    {
      "id": "mantra_ram",
      "title": "राम नाव",
      "language": "marathi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/mantras/ram.jpg",
      "orderIndex": 3,
      "content": [
        {
          "shloka": "श्रीराम जय राम जय जय राम",
          "meaning": "राम नाम मनाला शांती देते."
        }
      ]
    },
    {
      "id": "mantra_durga",
      "title": "दुर्गा मंत्र",
      "language": "marathi",
      "image": "https://amolgadge663.github.io/NityaSeva_Contents/images/chalisa/durga.jpg",
      "orderIndex": 4,
      "content": [
        {
          "shloka": "ॐ दुं दुर्गायै नमः",
          "meaning": "दुर्गा संरक्षण आणि शक्ती देते."
        }
      ]
    }
  ]
}
