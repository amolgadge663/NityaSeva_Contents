{
  "category": "Aarti",
  "version": 1,
  "items": [
    {
      "id": "aarti_ganapati",
      "title": "गणपती आरती",
      "language": "marathi",
      "image": "ganpati.png",
      "orderIndex": 1,
      "content": [
        {
          "shloka": "सुखकर्ता दुःखहर्ता वार्ता विघ्नाची",
          "meaning": "हे गणपती देवा, तू सुख देणारा व दुःख दूर करणारा आहेस.",
          "transliteration": null,
          "imageUrl": null
        },
        {
          "shloka": "जय देव जय देव जय मंगलमूर्ती",
          "meaning": "हे मंगलमूर्ती, तुझा जयजयकार असो.",
          "transliteration": null,
          "imageUrl": null
        }
      ]
    },
    {
      "id": "aarti_durga",
      "title": "दुर्गा आरती",
      "language": "marathi",
      "image": "durga.png",
      "orderIndex": 2,
      "content": [
        {
          "shloka": "जय देवी जय देवी जय महिषासुरमर्दिनी",
          "meaning": "देवी, तू महिषासुराचा संहार करणारी शक्ती आहेस."
        }
      ]
    },
    {
      "id": "aarti_vitthal",
      "title": "विठ्ठल आरती",
      "language": "marathi",
      "image": "vitthal.png",
      "orderIndex": 3,
      "content": [
        {
          "shloka": "युगायुगांचे आधी पांडुरंग",
          "meaning": "पांडुरंग हा भक्तांचा आधार आहे."
        }
      ]
    },
    {
      "id": "aarti_shankar",
      "title": "शंकराची आरती",
      "language": "marathi",
      "image": "shankar.png",
      "orderIndex": 4,
      "content": [
        {
          "shloka": "लवथवती विक्राळा ब्रह्मांडीं माळा",
          "meaning": "भगवान शंकर विक्राळ रूप धारण करणारे व ब्रह्मांड व्यापून टाकणारे आहेत.",
          "transliteration": null,
          "imageUrl": null
        },
        {
          "shloka": "जय देव जय देव जय श्रीशंकरा",
          "meaning": "हे श्रीशंकरा, तुझा जयजयकार असो.",
          "transliteration": null,
          "imageUrl": null
        }
      ]
    }
  ]
}
